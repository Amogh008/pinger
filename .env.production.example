APP_ENV=production
PORT=4002
WORDCONTROL_URL=https://wordcontrol-d8jk.onrender.com

# Base URL of dlt-session-tracker. The pinger hits <SESSION_TRACKER_URL>/pingtest
# every 30 seconds to keep it awake. Leave blank to disable pinging.
SESSION_TRACKER_URL=REPLACE_WITH_PRODUCTION_SESSION_TRACKER_URL
ASTRA_DB_APPLICATION_TOKEN=REPLACE_WITH_PRODUCTION_ASTRA_TOKEN
ASTRA_DB_KEYSPACE=wordcontrol
ASTRA_DB_SECURE_BUNDLE_PATH=/absolute/path/to/production-secure-connect-bundle.zip
ASTRA_DB_SECURE_BUNDLE_B64=
